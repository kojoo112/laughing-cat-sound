<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>io.github.kojoo112.laughing-cat-sound</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Laughing Cat Sound</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/kojoo112">kojoo112</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Something in your code just broke? A cat is already laughing at you.<br><br>

        This plugin plays a laughing cat sound the moment an error appears in your IDE,
        so a failed run never slips by unnoticed — with a bit of humor to soften the blow.<br><br>

        <b>It reacts when:</b>
        <ul>
            <li>a test fails,</li>
            <li>an application exits with an error (exit code 1 — e.g. a failed startup or an uncaught exception), or</li>
            <li>a run is aborted by a compilation error.</li>
        </ul>

        It stays silent when a process ends normally or when you stop the run yourself.<br><br>

        You can adjust the volume, mute it, or preview the sound in
        Settings/Preferences | Tools | Laughing Cat Sound.<br><br>

        <b>한국어</b><br>
        방금 코드가 터졌나요? 고양이가 벌써 웃고 있습니다.<br><br>

        IDE에서 에러가 발생하는 순간 웃는 고양이 소리를 재생합니다.
        실패한 실행을 놓치지 않고, 조금은 유쾌하게 알아챌 수 있습니다.<br><br>

        <b>이럴 때 반응합니다:</b>
        <ul>
            <li>테스트가 실패할 때</li>
            <li>애플리케이션이 에러로 종료될 때 (종료 코드 1 — 시작 실패, uncaught 예외 등)</li>
            <li>컴파일 에러로 실행이 중단될 때</li>
        </ul>

        프로세스가 정상 종료하거나, 사용자가 직접 실행을 멈춘 경우에는 소리가 나지 않습니다.<br><br>

        Settings/Preferences | Tools | Laughing Cat Sound 에서 볼륨을 조절하거나
        음소거할 수 있고, 소리를 미리 들어볼 수 있습니다.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Settings → Tools → Laughing Cat Sound 설정 페이지 (표시명은 번들에서 로케일별로 로드) -->
        <applicationConfigurable
            parentId="tools"
            instance="io.github.kojoo112.laughingcatsound.settings.LaughingCatConfigurable"
            id="io.github.kojoo112.laughingcatsound.settings.LaughingCatConfigurable"
            bundle="messages.LaughingCatBundle"
            key="settings.displayName"/>
    </extensions>

    <!-- 두 신호로 실패를 감지한다(둘 다 프로젝트 메시지 버스 토픽이라 projectListeners 로 등록).
         - ErrorExecutionListener: 프로세스가 종료 코드 1 로 끝나거나 실행 전 컴파일 실패 시
         - ErrorTestListener: IDE 테스트 러너에서 테스트가 실패할 때(종료 코드와 무관) -->
    <projectListeners>
        <listener
            class="io.github.kojoo112.laughingcatsound.ErrorExecutionListener"
            topic="com.intellij.execution.ExecutionListener"/>
        <listener
            class="io.github.kojoo112.laughingcatsound.ErrorTestListener"
            topic="com.intellij.execution.testframework.sm.runner.SMTRunnerEventsListener"/>
    </projectListeners>
</idea-plugin>